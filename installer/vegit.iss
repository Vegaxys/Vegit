; Windows installer for Vegit (Inno Setup 6). Build it with installer\build.ps1, which
; passes the version from Cargo.toml and the icon generated by build.rs:
;   ISCC /DAppVersion=0.2.0 /DIconFile=..\target\installer\vegit.ico installer\vegit.iss
;
; It installs for the current user only (no admin prompt), adds a Start menu entry and an
; uninstaller in Windows Settings. Vegit's settings (%APPDATA%\vegit) are left on uninstall
; so a reinstall finds them again.

#ifndef AppVersion
  #error Pass the version: /DAppVersion=x.y.z
#endif
#ifndef IconFile
  #error Pass the icon: /DIconFile=path\to\vegit.ico
#endif

[Setup]
; Never change AppId: Windows uses it to find the installed copy for upgrades.
AppId={{51582F2B-F826-4188-ACC9-8FF22FC64AE6}
AppName=Vegit
AppVersion={#AppVersion}
AppVerName=Vegit {#AppVersion}
AppPublisher=Vegaxys
AppPublisherURL=https://github.com/Vegaxys/Vegit
AppSupportURL=https://github.com/Vegaxys/Vegit/issues
AppUpdatesURL=https://github.com/Vegaxys/Vegit/releases
DefaultDirName={autopf}\Vegit
DefaultGroupName=Vegit
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir=..\target\installer
OutputBaseFilename=Vegit-Setup-{#AppVersion}
SetupIconFile={#IconFile}
UninstallDisplayIcon={app}\vegit.exe
UninstallDisplayName=Vegit
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
; An open Vegit is closed (and reopened) rather than leaving a locked vegit.exe.
CloseApplications=yes
RestartApplications=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "french"; MessagesFile: "compiler:Languages\French.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "..\target\release\vegit.exe"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\Vegit"; Filename: "{app}\vegit.exe"
Name: "{autodesktop}\Vegit"; Filename: "{app}\vegit.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\vegit.exe"; Description: "{cm:LaunchProgram,Vegit}"; Flags: nowait postinstall skipifsilent

[Code]
// Vegit drives the git command line: say so at the end if git can't be found, rather than
// letting the first screen fail. Not blocking: git may be installed right after.
procedure CurStepChanged(CurStep: TSetupStep);
var
  Code: Integer;
begin
  if (CurStep = ssPostInstall) and not WizardSilent then
  begin
    if not Exec(ExpandConstant('{cmd}'), '/C git --version', '', SW_HIDE, ewWaitUntilTerminated, Code) or (Code <> 0) then
      MsgBox('Vegit needs Git, which was not found on this computer.' + #13#10 +
             'Install it from https://git-scm.com, then start Vegit.', mbInformation, MB_OK);
  end;
end;
